# ============================================
# World Car Service - variaveis de ambiente
# Copie para .env.local e preencha
# ============================================

# --- Supabase / PostgreSQL ---
# Painel Supabase > Project Settings > Database > Connection string
# URL de runtime: use o "Transaction pooler" (porta 6543) com pgbouncer=true
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# URL direta (porta 5432) usada apenas pelas migrations do Prisma
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Sessao (JWT dos cookies de login) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-este-valor-por-uma-chave-aleatoria-longa"

# --- Supabase Storage (fotos das vistorias) ---
# Project Settings > API. Crie um bucket PRIVADO chamado "vistorias".
# Sem estas tres o sistema funciona normalmente, so o envio de fotos fica off.
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="chave-service-role-do-painel"
SUPABASE_BUCKET="vistorias"

# --- Seed (opcional) ---
# Credenciais do primeiro administrador criado por `npm run db:seed`.
# SEED_ADMIN_EMAIL="admin@worldcarservice.com.br"
# SEED_ADMIN_SENHA="troque-esta-senha"
